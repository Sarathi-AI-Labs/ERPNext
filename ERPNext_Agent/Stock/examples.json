    "plan": [
      {
        "step": 1,
        "tool": "search_documents",
        "parameters": {
          "doctype": "Bin",
          "filters": {
            "item_code": "ITEM-RAW-001",
            "warehouse": "Stores - S"
          },
          "fields": ["actual_qty", "reserved_qty", "projected_qty"]
        }
      }
    ]
  },
  {
    "scenario": "Create Material Receipt for Initial Balance",
    "prompt": "Receive 100 units of ITEM-BOLT-01 at rate 15 into Stores - S under SarathiAILabs",
    "plan": [
      {
        "step": 1,
        "tool": "create_document",
        "parameters": {
          "doctype": "Stock Entry",
          "values": {
