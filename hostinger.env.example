# ==============================================================================
# Hostinger VPS Production Environment Configuration
# Copy this file to .env on your VPS: cp hostinger.env.example .env
# ==============================================================================

# --- Application & Custom Image Settings ---
ERPNEXT_VERSION=v16.33.0
CUSTOM_IMAGE=sarathi/erpnext-sarathi
CUSTOM_TAG=v16.33.0

# CRITICAL for locally built custom images:
# Set to 'never' or 'if-not-present' so Docker Compose does NOT attempt
# to pull the locally built custom image from Docker Hub and fail.
PULL_POLICY=never
RESTART_POLICY=unless-stopped

# --- Database Credentials ---
# Change this to a strong, random password in production!
DB_PASSWORD=ChangeThisToAStrongSecretPassword123!

# Leave empty when using containerized MariaDB (overrides/compose.mariadb.yaml)
DB_HOST=
DB_PORT=

# Leave empty when using containerized Redis (overrides/compose.redis.yaml)
REDIS_CACHE=
REDIS_QUEUE=

# --- Performance & Worker Tuning ---
# For a 4GB RAM VPS (KVM 1): 2 workers, 2-4 threads
# For an 8GB RAM VPS (KVM 2): 2-4 workers, 4 threads
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# --- Web & Proxy Settings (Traefik + Let's Encrypt SSL) ---
# Your notification email for Let's Encrypt certificate expiration/renewals
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Domain routing rule for Traefik
# Single site: Host(`erp.yourdomain.com`)
# Multiple sites: Host(`erp.yourdomain.com`) || Host(`controltower.yourdomain.com`)
SITES_RULE=Host(`erp.yourdomain.com`)

# Default ports for web traffic
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

# Upload file size limit (50m, 100m, etc.)
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120

# Leave FRAPPE_SITE_NAME_HEADER empty so Frappe routes dynamically based on
# the Host header (erp.yourdomain.com), matching the site name created via bench new-site.
FRAPPE_SITE_NAME_HEADER=
